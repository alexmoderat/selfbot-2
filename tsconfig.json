{
	"compilerOptions": {
		"target": "ES2023",
		"module": "commonjs",
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["src/**/*.js", "src/**/*.d.ts"],
	"exclude": ["node_modules", "native"]
}
