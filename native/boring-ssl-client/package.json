{
  "name": "twitch-bot-boring-ssl-client",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome-TLS-Fingerprint-HTTP/2-Client (BoringSSL/Neon) -- optionaler Fallback fuer getBanStatusBatch(), siehe README.md.",
  "scripts": {
    "build-linux": "cargo-cp-artifact -nc ./build/linux.node -- cargo build -r --lib --target x86_64-unknown-linux-gnu --message-format=json-render-diagnostics",
    "build-macos": "cargo-cp-artifact -nc ./build/macos.node -- cargo build -r --lib --target x86_64-apple-darwin --message-format=json-render-diagnostics",
    "build-win": "cargo-cp-artifact -nc ./build/win.node -- cargo build -r --lib --target x86_64-pc-windows-msvc --message-format=json-render-diagnostics"
  },
  "devDependencies": {
    "cargo-cp-artifact": "^0.1"
  }
}
