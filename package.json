{
	"name": "selfbot-next",
	"version": "0.1.0",
	"type": "commonjs",
	"private": true,
	"description": "alexmoderat's Twitch-Bot, aufgebaut wie DontAddThisBot (IRC + PubSub, MongoDB)",
	"main": "src/main.js",
	"engines": {
		"node": ">= 24.0"
	},
	"scripts": {
		"start": "node --env-file=.env --enable-experimental-regexp-engine src/main.js",
		"dev": "node --env-file=.env --enable-experimental-regexp-engine --watch src/main.js",
		"test": "node --enable-experimental-regexp-engine --test-reporter=spec --test \"tests/**/*.test.js\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check \"./**/*.js\"",
		"format:fix": "prettier --write \"./**/*.js\"",
		"check": "yarn lint && yarn test",
		"migrate": "node --env-file=.env scripts/migrate-mariadb.js",
		"migrate:chatlines": "node --env-file=.env scripts/migrate-chatlines.js",
		"migrate:check": "node --env-file=.env scripts/check-migration.js"
	},
	"author": "alexmoderat",
	"license": "AGPL-3.0",
	"dependencies": {
		"@jprochazk/roll-dice": "^0.4.2",
		"@kararty/dank-twitch-irc": "^6.2.0",
		"chrono-node": "^2",
		"duration-parser": "supinic/duration-parser",
		"express": "^5.2.1",
		"ioredis": "^5",
		"jimp": "^1.6.0",
		"mariadb": "^3",
		"mongoose": "^8",
		"node-cron": "^4",
		"reconnecting-websocket": "^4.4.0",
		"swagger-ui-express": "^5.0.1",
		"transliteration": "^2",
		"ws": "^8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^9",
		"eslint": "^9",
		"globals": "^16",
		"prettier": "^3"
	}
}
